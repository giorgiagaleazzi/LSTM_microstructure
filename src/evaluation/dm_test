"""
Diebold-Mariano test.

Reference

Diebold and Mariano (1995)
"""

from __future__ import annotations

import numpy as np

from scipy import stats


def dm_test(

    actual,

    pred1,

    pred2,

):

    e1 = actual - pred1

    e2 = actual - pred2

    d = e1 ** 2 - e2 ** 2

    mean = np.mean(d)

    var = np.var(

        d,

        ddof=1,

    )

    statistic = (

        mean

        / np.sqrt(

            var

            / len(d)

        )

    )

    pvalue = (

        2

        * (

            1

            - stats.norm.cdf(

                np.abs(

                    statistic

                )

            )

        )

    )

    return statistic, pvalue
